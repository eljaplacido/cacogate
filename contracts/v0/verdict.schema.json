{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cacogate.local/contracts/v0/verdict.schema.json",
  "title": "Verdict and CheckStatus enumerations (ladder order is normative)",
  "$defs": {
    "Verdict": {
      "enum": ["allow", "sandbox", "canary", "revise", "request_evidence", "ask_human", "block"],
      "description": "Index in this array is the rung; combination = max rung over all checks' `allows`."
    },
    "CheckStatus": { "enum": ["passed", "failed", "not_applicable", "could_not_measure"] },
    "Pillar": { "enum": ["symbolic", "causal", "conformal", "budget", "provenance"] },
    "RuleClass": { "enum": ["invariant", "defeasible", "advisory"] },
    "ActionClass": {
      "enum": ["read", "local_edit", "shell_local", "vcs_local", "vcs_remote", "network", "deploy", "mcp", "delegate"]
    },
    "Digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
