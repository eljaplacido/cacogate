{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cacogate.local/contracts/v0/gate-decision.schema.json",
  "title": "GateDecision — the daemon's verdict, recorded in the ledger and projected to the harness",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "decision_id", "envelope_digest", "verdict", "checks", "policy_digest", "degradations", "latency_us", "decision_digest"],
  "properties": {
    "contract_version": { "const": "0.1.0" },
    "decision_id": { "type": "string" },
    "envelope_digest": { "$ref": "verdict.schema.json#/$defs/Digest" },
    "verdict": { "$ref": "verdict.schema.json#/$defs/Verdict" },
    "mode": { "enum": ["shadow", "enforce"] },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pillar", "id", "status", "allows"],
        "properties": {
          "pillar": { "$ref": "verdict.schema.json#/$defs/Pillar" },
          "id": { "type": "string" },
          "status": { "$ref": "verdict.schema.json#/$defs/CheckStatus" },
          "allows": { "$ref": "verdict.schema.json#/$defs/Verdict" },
          "rule_class": { "$ref": "verdict.schema.json#/$defs/RuleClass" },
          "detail": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind"],
        "properties": {
          "kind": { "enum": ["run", "septacore_check", "shadow_run", "human_review", "provide_context"] },
          "command": { "type": "array", "items": { "type": "string" } },
          "must_follow_seq": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "rationale": { "type": "string", "description": "Templated text; every number bound to a claim id." },
    "what_would_change_it": { "type": "array", "items": { "type": "string" } },
    "risk": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "conformal": {
          "type": "object", "additionalProperties": false,
          "required": ["stratum", "status"],
          "properties": {
            "stratum": { "$ref": "verdict.schema.json#/$defs/ActionClass" },
            "mode_set": { "type": "array", "items": { "enum": ["direct", "sandbox", "canary"] } },
            "alpha_target": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
            "status": { "enum": ["calibrated", "insufficient_n", "stale", "shifted", "absent"] },
            "calibration_id": { "type": "string" },
            "n_cal": { "type": "integer", "minimum": 0 }
          }
        },
        "causal": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "blast_radius": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "dependents": { "type": "integer", "minimum": 0 },
                "tests": { "type": "integer", "minimum": 0 },
                "services": { "type": "array", "items": { "type": "string" } },
                "public_api_touched": { "type": "boolean" },
                "owners_crossed": { "type": "array", "items": { "type": "string" } }
              }
            },
            "identification": { "enum": ["identified", "abstained", "not_attempted"] },
            "rig_digest": { "$ref": "verdict.schema.json#/$defs/Digest" }
          }
        }
      }
    },
    "policy_digest": { "$ref": "verdict.schema.json#/$defs/Digest" },
    "calibration_digest": { "$ref": "verdict.schema.json#/$defs/Digest" },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["cap_id", "action_digest", "mode", "not_after", "mac"],
      "properties": {
        "cap_id": { "type": "string" },
        "action_digest": { "$ref": "verdict.schema.json#/$defs/Digest" },
        "mode": { "enum": ["direct", "sandbox", "canary"] },
        "not_after": { "type": "string", "format": "date-time" },
        "mac": { "type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$" }
      }
    },
    "degradations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "detail"],
        "properties": { "id": { "type": "string" }, "detail": { "type": "string" } }
      }
    },
    "latency_us": { "type": "integer", "minimum": 0 },
    "decision_digest": { "$ref": "verdict.schema.json#/$defs/Digest" }
  }
}
