{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cacogate.local/contracts/v0/action-envelope.schema.json",
  "title": "ActionEnvelope \u2014 what an adapter sends the daemon before a tool executes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "envelope_id",
    "harness",
    "session_id",
    "tool_use_id",
    "tool",
    "args",
    "cwd",
    "ts",
    "action_digest"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "envelope_id": {
      "type": "string",
      "minLength": 1
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "adapter_version"
      ],
      "properties": {
        "name": {
          "enum": [
            "claude_code",
            "opencode",
            "pi",
            "omp",
            "gnomon",
            "codex",
            "gemini",
            "openfang",
            "other"
          ]
        },
        "version": {
          "type": "string"
        },
        "adapter_version": {
          "type": "string"
        },
        "interactive": {
          "type": "boolean"
        }
      }
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "string"
    },
    "tool_use_id": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string"
        },
        "parent_id": {
          "type": "string"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "endpoint_kind": {
          "type": "string"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_name"
      ],
      "properties": {
        "raw_name": {
          "type": "string",
          "description": "Harness-native tool name, e.g. Bash, edit, mcp__x__y"
        },
        "kind": {
          "enum": [
            "shell",
            "file_read",
            "file_write",
            "file_edit",
            "search",
            "net_fetch",
            "mcp",
            "delegate",
            "other"
          ],
          "description": "Adapter's hint; the kernel re-derives and records its own."
        }
      }
    },
    "args": {
      "type": "object",
      "description": "Harness-native arguments, canonicalised (JCS) before digesting."
    },
    "cwd": {
      "type": "string"
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        },
        "branch": {
          "type": "string",
          "description": "Current branch, when on one."
        }
      }
    },
    "surface_digest": {
      "$ref": "verdict.schema.json#/$defs/Digest",
      "description": "Harness config/surface hash when available (gnomon surface_hash, Claude settings hash)."
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "action_digest": {
      "$ref": "verdict.schema.json#/$defs/Digest",
      "description": "sha256(JCS({tool.raw_name, args, cwd, repo.root}))"
    }
  }
}
