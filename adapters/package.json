{
  "name": "@cacogate/adapters",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Zero-dependency cacogate adapters for OpenCode and pi/omp",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.3.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
